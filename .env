# Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Model selection
GEMINI_MODEL=gemini-2.5-flash

MONGO_URI=mongodb+srv://DIP:ilovedip@dip.omgmmbt.mongodb.net/?appName=DIP
PORT=3000
TELEGRAM_TOKEN=your_bot_token_here

# AWS S3 – leave blank to fall back to local filesystem storage for photos
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Public URL of this API server (used to build local photo URLs)
# Leave as default when running locally
PUBLIC_API_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000

